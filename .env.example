# Required Environment Variables

# App
NEXT_PUBLIC_APP_NAME=SplitFare
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy Authentication
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PRIVY_JWT_VERIFICATION_KEY=  # Optional: for faster local JWT verification

# ENS & Blockchain
NEXT_PUBLIC_CHAIN=sepolia
NEXT_PUBLIC_ENS_DOMAIN=splitfare.eth
NEXT_PUBLIC_CID_REGISTRY_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ANCHOR_PRIVATE_KEY=

# Namespace (ENS subdomain registration — get key at https://dev.namespace.ninja)
NAMESPACE_API_KEY=

# ────────────────────────────────────────────────────────────────────────────────
# Storacha (IPFS/IPLD decentralized storage)
#
# REQUIRED for production. Optional in development (falls back to local uploads).
#
# Quick setup:
#   1. Run:  chmod +x scripts/setup-storacha.sh && ./scripts/setup-storacha.sh
#   2. Paste the generated values below.
#
# Manual setup (https://docs.storacha.network/how-to/upload/#bring-your-own-delegations):
#   1. npm install -g @storacha/cli
#   2. storacha login <your-email>          # confirm via email link
#   3. storacha space create splitfare-platform
#   4. storacha key create                  # note the private key (Mg...) and DID
#   5. storacha delegation create <DID> \
#        --can space/blob/add --can space/index/add \
#        --can filecoin/offer --can upload/add \
#        --can space/blob/list --can upload/list --base64
#
# STORACHA_KEY:   Ed25519 private key (starts with "Mg...")
# STORACHA_PROOF: Base64-encoded delegation CAR
# Both must be set together, or both left empty.
# ────────────────────────────────────────────────────────────────────────────────
STORACHA_KEY=
STORACHA_PROOF=
# STORACHA_PRINCIPAL=       # Alias for STORACHA_KEY
# STORACHA_SPACE_DID=       # Optional: override which space to use
# IPFS_GATEWAY_HOST=storacha.link  # Optional: override default IPFS gateway

# Upstash Redis (rate limiting — optional in dev)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Resend (email notifications)
RESEND_API_KEY=
EMAIL_FROM=SplitFare <noreply@splitfare.io>

# Cron jobs (production: required, min 16 chars; send Authorization: Bearer <value> to /api/cron/bundle)
# CRON_SECRET=

# PWA theming
NEXT_PUBLIC_PWA_THEME_COLOR=#000000
NEXT_PUBLIC_PWA_BACKGROUND_COLOR=#000000
